// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  LGU_AGENT
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

model User {
  id             String     @id @default(uuid())
  name           String
  email          String     @unique
  passwordHash   String
  role           Role
  status         UserStatus @default(ACTIVE)

  // Jurisdiction, from PSGC (https://psgc.gitlab.io/api/). Null region = SUPER_ADMIN
  // (no jurisdiction at all). Province/municipality null = "entire region" / "entire province".
  regionCode         String?
  regionName         String?
  provinceCode       String?
  provinceName       String?
  municipalityCode   String?
  municipalityName   String?

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

enum Severity {
  HIGH
  LOW
}

enum ReportValidity {
  VALID
  FLAGGED
}

// Lookup table for report statuses: which ones count as "valid" vs "flagged"
// lives in data, not in code, so a query can join/filter on validity directly.
model ReportStatusCode {
  id       String         @id @default(uuid())
  value    String         @unique
  validity ReportValidity
  reports  Report[]
}

enum JurisdictionStatus {
  ASSIGNED
  UNASSIGNED
}

enum ImageKind {
  USER_UPLOAD
  RESOLUTION_PROOF
}

enum NoteKind {
  RESOLUTION
  REOPEN
}

model Report {
  id                   String              @id @default(uuid())
  lat                  Float
  lng                  Float
  severity             Severity?
  details              String
  locationLabel        String
  images               ReportImage[]
  notes                ReportNote[]
  statusValue          String              @default("PENDING")
  status               ReportStatusCode    @relation(fields: [statusValue], references: [value])
  createdAt            DateTime            @default(now())
  resolvedAt           DateTime?
  flaggedAt            DateTime?
  lguActionLogged      Boolean             @default(false)

  regionCode           String?
  regionName           String?
  provinceCode         String?
  provinceName         String?
  municipalityCode     String?
  municipalityName     String?
  jurisdictionStatus   JurisdictionStatus  @default(UNASSIGNED)
}

model ReportImage {
  id        String    @id @default(uuid())
  url       String
  kind      ImageKind @default(USER_UPLOAD)
  reportId  String
  report    Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
}

model ReportNote {
  id        String   @id @default(uuid())
  text      String
  kind      NoteKind
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
